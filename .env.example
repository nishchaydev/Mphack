# Copy to .env and fill in. Without a key the POC runs on bundled demo responses.
GEMINI_API_KEY=
# Pick a current model from https://ai.google.dev/gemini-api/docs/models (gemini-2.0-flash was shut down on 1 June 2026).
GEMINI_MODEL=gemini-3.5-flash
# minimal | low | medium | high, or blank to send no thinking config.
GEMINI_THINKING_LEVEL=low
# auto (live if a key is set) | live | mock
AI_MODE=auto

# Prices used for the per-call cost shown in the UI. Check https://ai.google.dev/gemini-api/docs/pricing
PRICE_INPUT_USD_PER_M=1.50
PRICE_OUTPUT_USD_PER_M=9.00
USD_INR=88

# Velocity sentinel: floor = words/READING_WPM min + SECONDS_PER_EQUATION + SECONDS_PER_DIAGRAM + BASE_SECONDS
READING_WPM=200
NUDGE_FRACTION=0.40
GATE_FRACTION=0.25
SEED_TOLERANCE=0.15
